# Copy to .env — never commit .env
# Prefix SENTINELRAG_ maps to Settings. Other keys are for provider SDKs.

# --- App ---
SENTINELRAG_APP_NAME=SentinelRAG
SENTINELRAG_ENV=prod
SENTINELRAG_HOST=0.0.0.0
SENTINELRAG_PORT=8000

# --- Qdrant (Compose overrides URL to http://qdrant:6333) ---
SENTINELRAG_QDRANT_URL=http://localhost:6333
SENTINELRAG_QDRANT_COLLECTION=sentinelrag

# --- Models (production-style defaults) ---
SENTINELRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SENTINELRAG_RERANKER_MODEL=BAAI/bge-reranker-base
SENTINELRAG_LLM_PROVIDER=gemini
SENTINELRAG_LLM_MODEL=gemini-2.0-flash

# --- Budgets ---
SENTINELRAG_COST_BUDGET_USD=0.05
SENTINELRAG_LATENCY_BUDGET_MS=5000

# --- Gemini (set when SENTINELRAG_LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=

# --- OpenAI (set when SENTINELRAG_LLM_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Azure OpenAI (preferred on this subscription; use provider=azure_openai later) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Hugging Face (optional model downloads) ---
HF_TOKEN=

# --- Azure VM connection (local ops only; never commit real values) ---
# AZURE_VM_HOST=
# AZURE_VM_USER=vm-sentinelrag
# AZURE_VM_SSH_KEY=
