# Copy to .env — never commit .env
# Prefix SENTINELRAG_ maps to Settings. Other keys are for provider SDKs.

# --- App (OSS contributors: keep mock defaults) ---
SENTINELRAG_APP_NAME=SentinelRAG
SENTINELRAG_ENV=dev
SENTINELRAG_HOST=0.0.0.0
SENTINELRAG_PORT=8000
SENTINELRAG_VECTOR_STORE_BACKEND=memory

# --- Qdrant (Compose overrides URL to http://qdrant:6333) ---
SENTINELRAG_QDRANT_URL=http://localhost:6333
SENTINELRAG_QDRANT_COLLECTION=sentinelrag

# --- Models (CI / offline defaults) ---
SENTINELRAG_EMBEDDING_MODEL=mock-embedder
SENTINELRAG_RERANKER_MODEL=mock-reranker
SENTINELRAG_LLM_PROVIDER=mock
SENTINELRAG_LLM_MODEL=mock-llm

# --- Budgets ---
SENTINELRAG_COST_BUDGET_USD=0.01
SENTINELRAG_LATENCY_BUDGET_MS=2000

# --- Live demo (Gemini only — uncomment for Azure / local real models) ---
# SENTINELRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# SENTINELRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# SENTINELRAG_LLM_PROVIDER=gemini
# SENTINELRAG_LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# --- Unused provider stubs (kept for interface parity; live track uses Gemini) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
HF_TOKEN=

# --- Azure VM deploy (local ops only; never commit real values) ---
# AZURE_VM_HOST=
# AZURE_VM_USER=
# AZURE_VM_SSH_KEY=
