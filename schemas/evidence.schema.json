{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakash888kp/SentinelRAG/schemas/evidence.schema.json",
  "title": "SentinelRAG Evidence Bundle",
  "description": "Portable CI evidence artifact (sentinelrag-evidence-v1). Optional app_revision + chunker_config identify what application revision and chunker the gate exercised.",
  "type": "object",
  "required": ["schema", "metrics"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "const": "sentinelrag-evidence-v1"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "project": { "type": "string" },
    "commit": { "type": ["string", "null"] },
    "app_revision": {
      "type": ["string", "null"],
      "description": "Application git SHA / build revision exercised by the gate (GITHUB_SHA or SENTINELRAG_APP_REVISION)."
    },
    "chunker_config": {
      "type": ["object", "null"],
      "description": "Chunker configuration used when collecting Retrieve evidence.",
      "properties": {
        "strategy": { "type": "string" },
        "chunk_size": { "type": "integer", "minimum": 1 },
        "chunk_overlap": { "type": "integer", "minimum": 0 }
      },
      "required": ["strategy", "chunk_size", "chunk_overlap"],
      "additionalProperties": true
    },
    "binding_mode": {
      "type": "string",
      "enum": ["fixture", "app"],
      "description": "fixture = bundled corpus/pipeline; app = consuming application chunker / adapter path."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": ["number", "string", "boolean", "object", "array", "null"] }
    },
    "security_probes": {
      "type": "object",
      "additionalProperties": true
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["rule", "message"]
      }
    },
    "passed": { "type": "boolean" }
  }
}
